# Copia este archivo a .env para desarrollo local, y en Vercel crea las mismas
# variables en Settings → Environment Variables (entorno Production).

# ID de medición de Google Analytics 4 (Admin → Flujos de datos → Web). Ej.: G-XXXXXXXXXX
# Si está vacío no se carga ningún script de Google.
PUBLIC_GA_ID=

# Token de verificación de Google Search Console, método "Etiqueta HTML":
# solo el valor de content="…" de <meta name="google-site-verification" content="…">.
# No hace falta si verificas el dominio por DNS.
PUBLIC_GSC_VERIFICATION=
